# Static asset caching (Workers Static Assets serves /_astro/* hashed files)
# HTML stays fresh for fast revalidation; hashed assets cache long.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=86400
/*.ico
  Cache-Control: public, max-age=86400
/sitemap*.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
