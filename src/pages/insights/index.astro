---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const canonical = 'https://dwntwnphx.com/insights/';
---

<Layout
  title="Downtown Phoenix Insights | dwntwnphx.com"
  description="Notes on Downtown Phoenix (DTPHX), downtown-first branding, and why dwntwnphx.com pairs with phxdwntwn.com."
  canonical={canonical}
>
  <Header />
  <main id="main" class="flex-1 bg-stone-50">
    <section class="section-padding">
      <div class="container-narrow max-w-3xl">
        <nav aria-label="Breadcrumb" class="mb-6 text-sm text-stone-500">
          <ol class="flex flex-wrap gap-1.5">
            <li><a href="/" class="hover:text-ember-600">Home</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-stone-700">Insights</li>
          </ol>
        </nav>

        <p class="text-xs font-semibold uppercase tracking-widestx text-ember-600">Insights</p>
        <h1 class="mt-3 font-display text-4xl font-bold text-dusk-950 sm:text-5xl">Downtown, written downtown-first</h1>
        <p class="mt-4 text-lg text-stone-600">
          Short notes on DTPHX, type-in demand, and the sister-pair strategy behind dwntwnphx.com.
        </p>

        {posts.length === 0 ? (
          <p class="mt-10 text-stone-600">No insights published yet.</p>
        ) : (
          <ul class="mt-10 space-y-4">
            {posts.map((post) => (
              <li>
                <a
                  href={`/insights/${post.slug}/`}
                  class="block rounded-md border border-stone-200 bg-white p-5 transition hover:border-ember-300 hover:shadow-sm"
                >
                  <h2 class="font-display text-2xl font-bold text-dusk-950">{post.data.title}</h2>
                  <p class="mt-2 text-stone-600">{post.data.description}</p>
                  <time class="mt-3 block text-sm text-stone-500" datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                      timeZone: 'America/Phoenix',
                    })}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
