  description="This page does not exist. Return to dwntwnphx.com — the premium Downtown Phoenix domain for sale at $50,000."
  canonical="https://dwntwnphx.com/"
>
  <main id="main" class="flex flex-1 items-center justify-center bg-stone-50 px-4 py-24">
    <div class="max-w-md text-center">
      <p class="text-xs font-semibold uppercase tracking-widestx text-ember-600">404</p>
      <h1 class="mt-3 font-display text-4xl font-bold text-dusk-950">This block is vacant</h1>
      <p class="mt-4 text-base text-stone-600">
        The page moved or never existed. The domain, however, is very much available.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a href="/" class="btn-primary">Back to dwntwnphx.com</a>
        <a href="/#acquisition" class="btn-outline">Buy — $50,000</a>
      </div>
    </div>
